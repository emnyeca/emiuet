# Default configuration for Emiuet firmware.
# These values are applied when generating sdkconfig (idf.py reconfigure/menuconfig).

# Enable USB-MIDI via esp_tinyusb
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1

# Development-only: keep the matrix simulator OFF by default so prototype
# bring-up uses real matrix scan behavior.
# CONFIG_MATRIX_SIM_ENABLED_DEFAULT is not set

# 1 ms tick: the 5 ms matrix scan, 1 ms USB/HID retries and u8g2 delays are
# shorter than the 10 ms tick of the ESP-IDF default (100 Hz) and were rounded.
CONFIG_FREERTOS_HZ=1000

# Target hardware (EUB-04): ESP32-S3-MINI-1-N4R2 has 4MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Rev.B peripherals and conservative, validation-adjustable RGB budgets.
CONFIG_EMIUET_MIDI_TRS_UART_ENABLE=y
CONFIG_EMIUET_MIDI_TRS_IN_ENABLE=y
CONFIG_EMIUET_RGB_ENABLE=y
CONFIG_EMIUET_RGB_DEFAULT_BUDGET_MA=200
CONFIG_EMIUET_RGB_1P5A_BUDGET_MA=1000
CONFIG_EMIUET_RGB_GLOBAL_BRIGHTNESS_MAX=96
